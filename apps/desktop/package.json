  "keywords": [
    "grok",
    "ai",
    "coding-agent",
    "electron",
    "desktop"
  ],
  "author": "SpaceXAI",
  "license": "Apache-2.0",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.2.0"
  }
}
